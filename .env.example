# TransportOS Environment Variables Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO THIS FILE

# Database Connection String
DATABASE_URL=

# Backend Server Configuration
PORT=8443
NODE_ENV=production

# Frontend API URL Configuration
VITE_API_URL=

# Optional Figma Public Asset URL
FIGMA_PUBLIC_URL=

# File Storage Provider ("local" or "s3")
STORAGE_PROVIDER=local

# AWS S3 Storage Settings (Required if STORAGE_PROVIDER=s3)
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
